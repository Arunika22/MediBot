<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Circle background (optional) -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.1"
        android:pathData="M12,2A10,10 0 1,1 2,12A10,10 0 0,1 12,2Z" />

    <!-- Each line is a short rectangle pointing to center from circumference -->
    <!-- Top -->
    <group android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="1"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Top-right -->
    <group android:rotation="45" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.8"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Right -->
    <group android:rotation="90" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.6"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Bottom-right -->
    <group android:rotation="135" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.4"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Bottom -->
    <group android:rotation="180" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.3"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Bottom-left -->
    <group android:rotation="225" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.2"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Left -->
    <group android:rotation="270" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.15"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>

    <!-- Top-left -->
    <group android:rotation="315" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#000000"
            android:fillAlpha="0.1"
            android:pathData="M11.5,2 L12.5,2 L12.5,7 L11.5,7 Z" />
    </group>
</vector>
